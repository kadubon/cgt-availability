{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kadubon/cgt-availability/schemas/availability-report.schema.json",
  "title": "CGT Availability AvailabilityReport",
  "type": "object",
  "required": [
    "claim_id",
    "status",
    "profile",
    "deficiencies",
    "dependency_closed_deficiencies",
    "warnings",
    "recommendations",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "claim_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "unformed",
        "partial",
        "complete",
        "well_typed",
        "coherent",
        "reproducibly_available",
        "continuation_sensitive",
        "blocked"
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "is_partial",
        "is_complete",
        "is_well_typed",
        "is_coherent",
        "is_reproducibly_available",
        "is_continuation_sensitive",
        "is_blocked"
      ],
      "properties": {
        "is_partial": {
          "type": "boolean"
        },
        "is_complete": {
          "type": "boolean"
        },
        "is_well_typed": {
          "type": "boolean"
        },
        "is_coherent": {
          "type": "boolean"
        },
        "is_reproducibly_available": {
          "type": "boolean"
        },
        "is_continuation_sensitive": {
          "type": "boolean"
        },
        "is_blocked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "deficiencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deficiency"
      }
    },
    "dependency_closed_deficiencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deficiency"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "deficiency": {
      "type": "object",
      "required": ["code", "component", "severity", "message", "depends_on", "metadata"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_frame",
            "missing_system",
            "missing_projection",
            "missing_observation",
            "missing_description",
            "missing_normalizer",
            "missing_expected_report",
            "missing_verifier",
            "missing_failure_predicate",
            "missing_reproduction_protocol",
            "missing_comparison_regime",
            "missing_provenance",
            "missing_history",
            "missing_marker_policy",
            "missing_marker_provenance",
            "marker_policy_incomplete",
            "missing_continuation",
            "missing_continuation_diagnostic",
            "verifier_failure_incoherent",
            "report_path_type_error",
            "protocol_incoherent",
            "direct_selector_degeneracy_risk",
            "report_only_insufficiency_risk",
            "marker_sensitive_missing_marker_policy",
            "continuation_sensitive_missing_continuation"
          ]
        },
        "component": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "blocking"]
        },
        "message": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
