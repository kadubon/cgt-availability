  "title": "CGT Availability ExternalModelCheckResult",
  "type": "object",
  "required": ["command", "returncode", "stdout", "stderr", "parsed", "metadata"],
  "properties": {
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "returncode": {
      "type": "integer"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "parsed": {
      "type": ["object", "null"]
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
