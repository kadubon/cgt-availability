{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kadubon/cgt-availability/schemas/residual-simulation-result.schema.json",
  "title": "CGT Availability ResidualSimulationResult",
  "type": "object",
  "required": ["source", "target", "matched", "missing", "depth", "bounded"],
  "properties": {
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "matched": {
      "type": "boolean"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "bounded": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
